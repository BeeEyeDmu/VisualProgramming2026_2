<Window x:Class="_033_StackPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_033_StackPanel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600"
        Background="BlanchedAlmond">
    <StackPanel Margin="30" Orientation="Vertical">
        <Button Margin="20" Padding="20">Button 1</Button>
        <Button Margin="20" Padding="20">Button 2</Button>
        <Button Margin="20" Padding="20">Button 3</Button>
    </StackPanel>
</Window>
