<Window x:Class="_042_WPFCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_042_WPFCalc"
        mc:Ignorable="d"
        Title="내가 만든 계산기" MinHeight="550" Height="550" 
        MinWidth="300" Width="450" 
        Background="#FFF3F3F3">
    <DockPanel VerticalAlignment="Stretch">
        <Grid Height="100" DockPanel.Dock="Top">
            <TextBlock x:Name="txtExp" HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="15"
                       FontSize="16"></TextBlock>
            <TextBlock x:Name="txtResult" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       FontSize="40" FontWeight="Bold"
                       Margin="10 10 15 10">0</TextBlock>
        </Grid>
        <Grid Height="50" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnMC" Grid.Column="0" FontSize="14" BorderThickness="0"
                    FontWeight="Normal"  Background="WhiteSmoke">MC</Button>
            <Button x:Name="btnMR" Grid.Column="1" FontSize="14" BorderThickness="0"
                    FontWeight="Normal" Background="WhiteSmoke">MR</Button>
            <Button x:Name="btnMPlus" Grid.Column="2" FontSize="14" BorderThickness="0"
                    FontWeight="Normal" Background="WhiteSmoke">M+</Button>
            <Button x:Name="btnMMinus" Grid.Column="3" FontSize="14" BorderThickness="0"
                    FontWeight="Normal" Background="WhiteSmoke">M-</Button>
            <Button x:Name="btnMS" Grid.Column="4" FontSize="14" BorderThickness="0"
                    FontWeight="Normal" Background="WhiteSmoke">MS</Button>
        </Grid>
        <Grid MinHeight="360" DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- 첫번째 줄-->
            <Button x:Name="btnPercent" Grid.Row="0" Grid.Column="0" BorderThickness="0"
                    FontSize="18" Margin="2 1 1 1" Background="#FFFAFAFA">%</Button>
            <Button x:Name="btnCE" Grid.Row="0" Grid.Column="1" BorderThickness="0"
                FontSize="18" Margin="1" Background="#FFFAFAFA">CE</Button>
            <Button x:Name="btnC" Grid.Row="0" Grid.Column="2" BorderThickness="0"
                FontSize="18" Margin="1" Background="#FFFAFAFA">C</Button>
            <Button x:Name="btnDelete" Grid.Row="0" Grid.Column="3" BorderThickness="0"
                FontSize="18" Margin="1 1 2 1" Background="#FFFAFAFA">⌫</Button>
            <!-- 두번째 줄-->
            <Button x:Name="btnRecip" Grid.Row="1" Grid.Column="0" BorderThickness="0"
                    FontSize="18" Margin="2 1 1 1" Background="#FFFAFAFA"
                    Click="btnRecip_Click">1/x</Button>
            <Button x:Name="btnSqr" Grid.Row="1" Grid.Column="1" BorderThickness="0"
                FontSize="18" Margin="1" Background="#FFFAFAFA"
                Click="btnSqr_Click">x²</Button>
            <Button x:Name="btnSqrt" Grid.Row="1" Grid.Column="2" BorderThickness="0"
                FontSize="18" Margin="1" Background="#FFFAFAFA"
                Click="btnSqrt_Click">√</Button>
            <Button x:Name="btnDivide" Grid.Row="1" Grid.Column="3" BorderThickness="0"
                FontSize="18" Margin="1 1 2 1" Background="#FFFAFAFA"
                Click="btnPlus_Click">÷</Button>
            <!-- 세번째 줄-->
            <Button x:Name="btn7" Grid.Row="2" Grid.Column="0" BorderThickness="0"
                    FontSize="18" Margin="2 1 1 1" Background="White" Click="btn1_Click">7</Button>
            <Button x:Name="btn8" Grid.Row="2" Grid.Column="1" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">8</Button>
            <Button x:Name="btn9" Grid.Row="2" Grid.Column="2" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">9</Button>
            <Button x:Name="btnTimes" Grid.Row="2" Grid.Column="3" BorderThickness="0"
                FontSize="18" Margin="1 1 2 1" Background="#FFFAFAFA"
                Click="btnPlus_Click">×</Button>
            <!-- 네번째 줄-->
            <Button x:Name="btn4" Grid.Row="3" Grid.Column="0" BorderThickness="0"
                FontSize="18" Margin="2 1 1 1" Background="White" Click="btn1_Click">4</Button>
            <Button x:Name="btn5" Grid.Row="3" Grid.Column="1" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">5</Button>
            <Button x:Name="btn6" Grid.Row="3" Grid.Column="2" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">6</Button>
            <Button x:Name="btnMinus" Grid.Row="3" Grid.Column="3" BorderThickness="0"
                FontSize="18" Margin="1 1 2 1" Background="#FFFAFAFA"
                Click="btnPlus_Click">-</Button>
            <!-- 다섯번째 줄-->
            <Button x:Name="btn1" Grid.Row="4" Grid.Column="0" BorderThickness="0"
                FontSize="18" Margin="2 1 1 1" Background="White" Click="btn1_Click">1</Button>
            <Button x:Name="btn2" Grid.Row="4" Grid.Column="1" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">2</Button>
            <Button x:Name="btn3" Grid.Row="4" Grid.Column="2" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">3</Button>
            <Button x:Name="btnPlus" Grid.Row="4" Grid.Column="3" BorderThickness="0"
                FontSize="18" Margin="1 1 2 1" Background="#FFFAFAFA"
                Click="btnPlus_Click">+</Button>
            <!-- 여섯번째 줄-->
            <Button x:Name="btnPlsMinus" Grid.Row="5" Grid.Column="0" BorderThickness="0"
                FontSize="18" Margin="2 1 1 1" Background="White" Click="btnPlsMinus_Click">±</Button>
            <Button x:Name="btn0" Grid.Row="5" Grid.Column="1" BorderThickness="0"
                FontSize="18" Margin="1" Background="White" Click="btn1_Click">0</Button>
            <Button x:Name="btnDot" Grid.Row="5" Grid.Column="2" BorderThickness="0"
                FontSize="18" Margin="1" Background="White"
                Click="btnDot_Click">.</Button>
            <Button x:Name="btnEqual" Grid.Row="5" Grid.Column="3" BorderThickness="0"
                FontSize="18" Margin="1" Background="#FF0067C0" 
                Foreground="White" Content="="
                Click="btnEqual_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </DockPanel>
</Window>
