<Window x:Class="_035_Language.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_035_Language"
        mc:Ignorable="d"
        Title="언어 선택" Height="380" Width="400"
        Background="LightSteelBlue">
    <StackPanel Margin="20" Background="AliceBlue" VerticalAlignment="Center" >
        <TextBlock HorizontalAlignment="Center"
                   Padding="10">◆ 좋아하는 프로그래밍 언어를 선택하세요.</TextBlock>
        <Separator Margin="10" Background="LightSteelBlue"/>
        <CheckBox x:Name="cbC" Margin="30 5 0 0 ">C</CheckBox>
        <CheckBox x:Name="cbCPP" Margin="30 5 0 0 ">C++</CheckBox>
        <CheckBox x:Name="cbCS" Margin="30 5 0 0 ">C#</CheckBox>
        <CheckBox x:Name="cbPython" Margin="30 5 0 0 ">Python</CheckBox>
        <CheckBox x:Name="cbJava" Margin="30 5 0 5 ">Java</CheckBox>
        <Separator Margin="10" Background="LightSteelBlue"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnSubmit" Margin="10" Width="100"
                    Click="btnSubmit_Click">투표하기</Button>
            <Button x:Name="btnQuit" Margin="10" Width="100"
                    Click="btnQuit_Click">끝내기</Button>
        </StackPanel>
    </StackPanel>
</Window>
